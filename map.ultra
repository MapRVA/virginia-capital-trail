---
type: overpass
#server: https://overpass.maprva.org/api
server: https://overpass-staging.maprva.org/api
style:
  extends: https://styles.maprva.org/maptiler-basic.json
  sprite: https://maprva.github.io/virginia-capital-trail/sprites
  layers:
    - # the trail!
      type: line
      filter: [ ==, [ get, type ], route ]
      line-width: 4
      line-color: '#555'
    - # milestones
      type: symbol
      filter:
        - all
        - [ ==, [ get, highway ], milestone ]
      icon-image: milestone
      icon-anchor: right
      icon-overlap: always
      text-field: [get, distance]
      text-anchor: left
      text-size: 12
      text-halo-color: white
      text-halo-width: 2
    - # Clustered POI - high zoom - individual markers
      type: symbol
      minzoom: 15
      filter:
        - all
        - [ ==, [ geometry-type ], Point ]
        - [has, minzoom]
        - ['!', [has, maxzoom]]
        - [ '!=' , [get, highway], milestone]
      icon-anchor: bottom
      icon-overlap: always
      text-field: [get, name]
      text-optional: true
      text-halo-color: white
      text-halo-width: 2
      text-size: 13
      text-anchor: left
      text-justify: left
      text-offset: [1.25, -1.5]
      icon-image: &icons
        - case
        - [ ==, [ get, amenity ], toilets ]
        - toilets
        - [ ==, [ get, amenity ], parking ]
        - parking
        - [ ==, [ get, amenity ], bicycle_repair_station ]
        - bicycle_repair_station
        - [ ==, [ get, craft ], winery ]
        - winery
        - [ ==, [ get, craft ], brewery ]
        - brewery
        - [ ==, [ get, amenity ], fast_food ]
        - restaurant
        - [ ==, [ get, amenity ], library ]
        - library
        - [ ==, [ get, amenity ], restaurant ]
        - restaurant
        - [ ==, [ get, shop ], convenience ]
        - convenience_store
        - [ ==, [ get, shop ], bicycle ]
        - bike_shop
        - [ ==, [ get, shop ], supermarket ]
        - grocery_store
        - [ ==, [ get, tourism ], camp_site ]
        - campground
        - [ ==, [ get, tourism ], hotel ]
        - lodging
        - [ ==, [ get, tourism ], guest_house ]
        - lodging
        - [ has, historic ]
        - historic
        - [ ==, [ get, amenity ], drinking_water ]
        - water
        - [ ==, [ get, leisure ], park ]
        - park
        - [ ==, [ get, leisure ], picnic_table ]
        - picnic_table
        - [ ==, [ get, tourism ], picnic_site ]
        - picnic_table
        - pinhead-js:dot?shape=map_pin
    - # Non-Clustered POI
      type: symbol
      filter:
        - all
        - [ ==, [ geometry-type ], Point ]
        - ['!', [has, minzoom]]
        - ['!', [has, maxzoom]]
        - [ '!=' , [get, highway], milestone]
      icon-anchor: bottom
      icon-image: *icons
      text-field: [get, name]
      text-halo-color: white
      text-halo-width: 2
      text-size: 13
      text-optional: true
      text-anchor: left
      text-justify: left
      text-offset: [1.25, -1.5]
    - # clusters - low zoom
      type: symbol
      maxzoom: 15
      filter: [ has, maxzoom ]
      #icon-anchor: right
      #text-offset: [.25, 0]
      #icon-offset: [0, .125]
      #icon-image: pinhead-js:dot?shape=map_pin&scale=1.25
      text-anchor: left
      text-justify: left
      text-halo-color: white
      text-halo-width: 2
      text-overlap: always
      text-field:
        - format
        - [get, name]
        - {}
        - [ literal, "\n" ]
        - {}
        - - case
          - ["in", "camp_site", ["get", "amenities"]]
          - [image, [literal, campground-square]]
          - ''
        - {}
        - - case
          - ["in", "camp_site", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "parking", ["get", "amenities"]]
          - [image, [literal, parking-square]]
          - ''
        - {}
        - - case
          - ["in", "parking", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "toilets", ["get", "amenities"]]
          - [image, [literal, toilets-square]]
          - ''
        - {}
        - - case
          - ["in", "toilets", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - [any, ["in", "restaurant", ["get", "amenities"]], ["in", "fast_food", ["get", "amenities"]]]
          - [image, [literal, restaurant-square]]
          - ''
        - {}
        - - case
          - [any, ["in", "restaurant", ["get", "amenities"]], ["in", "fast_food", ["get", "amenities"]]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "guest_house", ["get", "amenities"]]
          - [image, [literal, lodging-square]]
          - ''
        - {}
        - - case
          - ["in", "guest_house", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "drinking_water", ["get", "amenities"]]
          - [image, [literal, water-square]]
          - ''
        - {}
        - - case
          - ["in", "drinking_water", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "picnic_table", ["get", "amenities"]]
          - [image, [literal, picnic_table-square]]
          - ''
        - {}
        - - case
          - ["in", "picnic_table", ["get", "amenities"]]
          - ' '
          - ''
        - {}
        - - case
          - ["in", "bicycle_repair_station", ["get", "amenities"]]
          - [image, [literal, bicycle_repair_station-square]]
          - ''
        - {}
        - - case
          - ["in", "bicycle_repair_station", ["get", "amenities"]]
          - ' '
          - ''
transform: |
  export default async (data) => {
    const {distance} = await import(`${typeof process === 'undefined' ? "https://esm.sh/" : ""}@turf/distance`);
    const clusters = [
      [({properties}) => properties.wikidata == 'Q116302533', 0.5], // lawrence lewis jr park
      [({properties}) => properties.wikidata == 'Q3474376', 0.25], // charles city
      [({properties}) => properties.highway == 'trailhead', 0.5],
      [({properties}) => properties.wikidata == 'Q49495628', 0.25], // Great Shiplock Park
      [({properties}) => properties.wikidata == 'Q141914540', 1], // Chickahominy
    ]  
    
    const clusterablePoints = data.features.filter(p =>
      p.geometry.type == 'Point' &&
      p.properties.highway != 'milestone');

    const clusterFeatures = [];
    for (const [f, d] of clusters) {
      for (const clusterPoint of data.features.filter(f)) {
        clusterPoint.properties.maxzoom = true;
        clusterPoint.properties.amenities = clusterablePoints
          .filter(p => distance(p.geometry.coordinates, clusterPoint.geometry.coordinates) < d)
          .map(p => {
            p.properties.minzoom = true;
            return p.properties.amenity || p.properties.tourism || p.properties.leisure
          });
        delete clusterPoint.properties.minzoom;
        clusterFeatures.push(clusterPoint);
      }
    }
    const nonClusters = data.features.filter(({properties}) => properties.highway !== 'trailhead' && !properties.place);
    return {type: 'FeatureCollection', features: [...nonClusters, ...clusterFeatures]};
  }
---
[out:json];

// the route
relation[wikidata=Q7934165] -> .route;
.route out geom;

// amenities near the route
(
  nwr[amenity=drinking_water](around.route:100);
  nwr[shop=bicycle](around.route:100);
  nwr[tourism=camp_site][backcountry!=yes](around.route:2000);
  nwr[tourism=guest_house](around.route:5000);
  nwr[tourism=hotel](around.route:1000);
  nwr[amenity=toilets](around.route:100);
  nwr[amenity=parking][access=yes](around.route:100);
  nwr[leisure=picnic_table](around.route:50);
  nwr[tourism=picnic_site](around.route:500);
  nwr[amenity=bicycle_repair_station](around.route:50);
  nwr[amenity=restaurant](around.route:200);
  nwr[shop=supermarket](around.route:500);
  nwr[amenity=fast_food](around.route:200);
  nwr[shop=convenience](around.route:100);
  nwr[leisure=park][name][wikidata!=Q5148351](around.route:100);
  node[highway=trailhead](around.route:100);
  nwr[craft=brewery](around.route:1000);
  nwr[craft=winery](around.route:5000);
  nwr[amenity=library](around.route:500);
);
out center;

// specific places & milestones
(
  node[place][wikidata=Q3474376]; // charles city
  nwr[wikidata=Q116302533][leisure=park]; // lawrence lewis jr park
  node[highway=milestone][ref='Virginia Capital Trail'];
);
out center;

// amenities at lawrence lewis jr park
area[wikidata=Q116302533][leisure=park] -> .lljp; // lawrence lewis jr park
(
  node[amenity=bicycle_repair_station](area.lljp);
  nwr[amenity=toilets](area.lljp);
  nwr[leisure=picnic_table](area.lljp);
  node[amenity=picnic_table](area.lljp);
);
out center;
